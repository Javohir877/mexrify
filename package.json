{
  "name": "mexrify",
  "version": "1.0.0",
  "private": true,
  "description": "MEXRIFY — React + Node.js musiqa platformasi",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
